
FROM debian:bookworm-slim

# Avoid prompts from apt
ENV DEBIAN_FRONTEND=noninteractive

# Set up a non-root user
RUN id -g "{{ GROUP_NAME }}" || groupadd -r "{{ GROUP_NAME }}"; \
    groupmod -g "{{ GROUP_ID }}" "{{ GROUP_NAME }}"; \
    id -u "{{ USER_NAME }}" || useradd -r "{{ USER_NAME }}"; \
    usermod -u "{{ USER_ID }}" -g "{{ GROUP_ID }}" -s "{{ USER_SHELL }}" "{{ USER_NAME }}"

# Install bootstrap packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        apt-transport-https ca-certificates debian-keyring gnupg \
        && \
    apt-get clean && \
    rm -fr /var/lib/apt/lists/* \
    rm -fr /etc/apt/sources.list*

# Add custom sources.list
COPY "{{ INITIAL_SOURCES_LIST | basename }}" /etc/apt/sources.list

# Install base packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        locales dialog sudo \
        dpkg apt aptitude apt-utils \
        bash bash-completion \
        vim mc sed gawk \
        python3 python3-pkgconfig python3-pip python3-virtualenv python3-venv python3-pytest \
        && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Switch to non-root user
USER "{{ USER_NAME }}"

CMD {{ IMAGE_CMD }}
