FROM docker.io/debian:bookworm-slim

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV USER=runner
ENV HOME=/home/runner

# Create user and groups
RUN groupadd -r runner && \
    groupadd -r docker && \
    useradd -r -g runner -G sudo,docker -d /home/runner -s /bin/bash runner && \
    mkdir -p /home/runner && \
    chown runner:runner /home/runner

# Configure APT
RUN mkdir -p /etc/apt/apt.conf.d/ && \
    mkdir -p /usr/share/man/man1/

# Copy APT configuration files
COPY lib/assets/apt/apt.conf.d/suggestions.conf /etc/apt/apt.conf.d/
COPY lib/assets/apt/apt.conf.d/proxy.conf /etc/apt/apt.conf.d/

# Install bootstrap packages with SSL support
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libncursesw6 \
        dialog \
        libssl3 \
        openssl \
        ca-certificates \
        apt-transport-https \
        gnupg \
        && \
    apt-get clean

# Copy sources lists and GPG keys (these would need to be created based on your assets)
COPY lib/assets/apt/sources.list.d/bookworm.list /etc/apt/sources.list.d/
COPY lib/assets/apt/sources.list.d/*.list /etc/apt/sources.list.d/disabled/
COPY lib/assets/apt/keys/*.asc lib/assets/apt/keys/*.gpg /etc/apt/trusted.gpg.d/

# Update package lists and upgrade system
RUN \
    rm -f /etc/apt/sources.list && \
    sed -e 's/^\(deb\) (^https:\/\/security).* \(bookworm.*\)$/\1 https:\/\/debian.charite.de\/debian\/ \2/g' -i /etc/apt/sources.list.d/bookworm.list && \
    apt-get update && \
    apt-get upgrade -y && \
    apt-get clean

COPY lib/assets/apt/package-bundles/*.list lib/assets/apt/package-bundles/compiler /etc/apt/package-bundles/

# Install additional packages
RUN apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        $(grep -v ^# /etc/apt/package-bundles/debian-essentials.list) \
        $(grep -v ^# /etc/apt/package-bundles/console-tools.list) \
        $(grep -v ^# /etc/apt/package-bundles/networking.list) \
        $(grep -v ^# /etc/apt/package-bundles/build-tools.list) \
        $(grep -v ^# /etc/apt/package-bundles/python3.list) \
        $(grep -v ^# /etc/apt/package-bundles/version-control.list) \
        && \
    apt-get clean

# Configure shell for runner user
RUN echo 'export PS1="\u@\h:\w\$ "' >> /home/runner/.bashrc && \
    echo 'alias ll="ls -la"' >> /home/runner/.bashrc && \
    echo 'alias la="ls -A"' >> /home/runner/.bashrc && \
    echo 'alias l="ls -CF"' >> /home/runner/.bashrc && \
    chown -R runner:runner /home/runner

# Configure sudo for runner user
COPY lib/assets/sudoers.d/runner /etc/sudoers.d/runner
RUN chmod 440 /etc/sudoers.d/runner

# Configure vim
COPY lib/assets/vimrc/default /etc/vim/vimrc.local

# Set up ccache directory
RUN mkdir -p /home/runner/.ccache && \
    ln -s /home/runner/.ccache /root/.ccache && \
    chown runner:runner /home/runner/.ccache

#
# Install OpenCL packages
#
RUN apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        $(grep -v ^# /etc/apt/package-bundles/opencl.list) \
        && \
    apt-get clean

#
# Install Nvidia packages
#
COPY lib/assets/apt/sources.list.d/nvidia/debian.list /etc/apt/sources.list.d/
RUN apt-get update && \
    apt-get install -y --no-install-recommends --no-install-suggests \
        $(grep -v ^# /etc/apt/package-bundles/nvidia.list) \
        && \
    apt-get clean

# Clean up expendable files
RUN apt-get autoremove -y && \
    apt-get autoclean && \
    rm -rf \
        /var/lib/apt/lists/* \
        /tmp/* \
        /var/tmp/* \
        /usr/share/doc \
        /usr/share/man \
        /usr/share/locale \
        /usr/share/zoneinfo \
        /usr/share/i18n \
        /usr/share/iso-codes \
        /usr/share/X11 \
        /usr/share/icons \
        && \
    find /var/log -type f -exec truncate -s 0 {} \;

# Switch to runner user
USER runner
WORKDIR /home/runner

# Default command
# ENTRYPOINT ["/bin/bash"]
# CMD ["-l", "-c"]
CMD ["/bin/bash"]
