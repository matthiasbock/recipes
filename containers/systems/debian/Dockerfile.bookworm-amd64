FROM docker.io/debian:bookworm-slim

# Set environment variables
ENV DEBIAN_FRONTEND=noninteractive
ENV USER=runner
ENV HOME=/home/runner

# Create user and groups
RUN groupadd -r runner && \
    groupadd -r docker && \
    useradd -r -g runner -G sudo,docker -d /home/runner -s /bin/bash runner && \
    mkdir -p /home/runner && \
    chown runner:runner /home/runner

# Configure APT
RUN mkdir -p /etc/apt/apt.conf.d/ && \
    mkdir -p /usr/share/man/man1/

# Copy APT configuration files
COPY lib/assets/apt/apt.conf.d/suggestions.conf /etc/apt/apt.conf.d/
COPY lib/assets/apt/apt.conf.d/proxy.conf /etc/apt/apt.conf.d/

# Install bootstrap packages with SSL support
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        libncursesw6 \
        dialog \
        libssl3 \
        openssl \
        ca-certificates \
        apt-transport-https \
        gnupg \
        && \
    apt-get clean

# Copy sources lists and GPG keys (these would need to be created based on your assets)
COPY lib/assets/apt/sources.list.d/bookworm.list /etc/apt/sources.list.d/
COPY lib/assets/apt/sources.list.d/*.list /etc/apt/sources.list.d/disabled/
COPY lib/assets/apt/keys/ /etc/apt/trusted.gpg.d/

# Update package lists and upgrade system
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get clean

# Install additional packages from debian-essentials and console-tools bundles
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        vim \
        nano \
        htop \
        tree \
        less \
        grep \
        sed \
        gawk \
        curl \
        wget \
        unzip \
        zip \
        sudo && \
    apt-get clean

# Configure sudo for runner user
COPY lib/assets/sudoers.d/runner /etc/sudoers.d/runner
RUN chmod 440 /etc/sudoers.d/runner

# Configure vim
COPY lib/assets/vimrc/default /etc/vim/vimrc.local

# Set up ccache directory
RUN mkdir -p /home/runner/.ccache && \
    ln -s /home/runner/.ccache /root/.ccache && \
    chown runner:runner /home/runner/.ccache

# Configure shell for runner user
RUN echo 'export PS1="\u@\h:\w\$ "' >> /home/runner/.bashrc && \
    echo 'alias ll="ls -la"' >> /home/runner/.bashrc && \
    echo 'alias la="ls -A"' >> /home/runner/.bashrc && \
    echo 'alias l="ls -CF"' >> /home/runner/.bashrc

# Clean up expendable files
RUN apt-get autoremove -y && \
    apt-get autoclean && \
    rm -rf /var/lib/apt/lists/* && \
    rm -rf /tmp/* && \
    rm -rf /var/tmp/* && \
    find /var/log -type f -exec truncate -s 0 {} \;

# Set proper ownership
RUN chown -R runner:runner /home/runner

# Switch to runner user
USER runner
WORKDIR /home/runner

# Default command
# ENTRYPOINT ["/bin/bash"]
# CMD ["-l", "-c"]
CMD ["/bin/bash"]

